{
  "expo": {
    "name": "PowerLevel",
    "slug": "powerlevel",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "powerlevel",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "android": {
      "package": "com.tushar.powerlevel",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "android"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07f2c48b-19f5-4fa0-ab57-ce7dafe1fe34"
      }
    }
  }
}
